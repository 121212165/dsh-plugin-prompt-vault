{
  "name": "dsh-plugin-prompt-vault",
  "version": "0.1.0",
  "description": "dsh plugin: personal prompt library inside the harness. Import tagged prompt templates, list/show them, and send one as a user message in the current session.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon.svg": "./icon.svg",
    "./seed/*": "./seed/*"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale",
    "seed"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "prompts",
    "library",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-prompt-vault.git"
  },
  "bugs": {
    "url": "https://github.com/121212165/dsh-plugin-prompt-vault/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "icon": "./icon.svg"
}
